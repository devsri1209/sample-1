import time

def function1(txt, pat, m, n):
    for i in range(m - n + 1):
        if txt[i:i+n] == pat:
            return i
    return -1

# Open files
f = open("input1.txt", "r")
f2 = open("pattern.txt", "r")

# Read data from files
txt = f.read().strip()
pat = f2.read().strip()

# Close files
f.close()
f2.close()

# Start time
stime = time.time()

# Function call
result = function1(txt, pat, len(txt), len(pat))

# End time
etime = time.time()

# Output
if result != -1:
    print("Pattern found at index:", result)
else:
    print("Pattern not found")

print("Length of Text:", len(txt))
print("Length of Pattern:", len(pat))

print("Execution Time:", etime - stime, "seconds")
