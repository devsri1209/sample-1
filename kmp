import time

def computeLPSArray(pat, m, lps):

    length = 0
    lps[0] = 0

    i = 1

    while i < m:

        if pat[i] == pat[length]:

            length += 1
            lps[i] = length
            i += 1

        else:

            if length != 0:
                length = lps[length - 1]

            else:
                lps[i] = 0
                i += 1


def KMPSearch(pat, txt):

    m = len(pat)
    n = len(txt)

    lps = [0] * m

    j = 0

    computeLPSArray(pat, m, lps)

    i = 0

    found = False

    while i < n:

        if pat[j] == txt[i]:
            i += 1
            j += 1

        if j == m:
            print("Pattern found at index :", i - j)

            found = True

            j = lps[j - 1]

        elif i < n and pat[j] != txt[i]:

            if j != 0:
                j = lps[j - 1]

            else:
                i += 1

    if not found:
        print("Pattern not found")

    print("LPS Array :", lps)


# Input
txt = input("Enter Text : ")
pat = input("Enter Pattern : ")

# Start Time
stime = time.time()

# Function Call
KMPSearch(pat, txt)

# End Time
etime = time.time()

# Output
print("Length of Text :", len(txt))
print("Length of Pattern :", len(pat))

print("Execution Time :", etime - stime, "seconds")
